```gitignore
# Environment variables and secrets
.env
.env.*

# Allow an example environment file
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# HTTP request files containing credentials or tokens
test/request.http

# Flask instance data and SQLite databases
instance/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Database backups
*.backup
*.bak

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
```
